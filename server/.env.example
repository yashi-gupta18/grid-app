NODE_ENV=development
PORT=4000
# Replace the placeholders with your Atlas database user and cluster host.
# URL-encode special characters in the username and password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pixelclaim?retryWrites=true&w=majority
# For local MongoDB instead:
# MONGODB_URI=mongodb://127.0.0.1:27017/pixelclaim
CLIENT_ORIGIN=http://localhost:5173
CLAIM_COOLDOWN_MS=1200
